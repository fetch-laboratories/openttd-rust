+/* Each recorded call as kind:a:b:c, in call order. A draw is its kind alone: its value
+ * follows from the seed and the number of draws before it. */
+static std::string Trace()
+{
+	std::string out;
+	for (const auto &entry : trace) {
+		out += " " + std::to_string(entry[0]);
